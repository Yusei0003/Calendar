# ── 合言葉 ───────────────────────────────────────────────
# スタッフ全員で共有するパスコード。運用開始時に決めて設定する。
APP_PASSCODE=

# ログインCookieの署名に使う秘密の文字列。
# 次のコマンドで生成した値を貼る: openssl rand -base64 32
SESSION_SECRET=

# ── Supabase ─────────────────────────────────────────────
# Supabase の管理画面 → Project Settings → API から取得する。
# 未設定の場合、アプリはローカルのファイル保存（.data/）で動作する（開発用）。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
